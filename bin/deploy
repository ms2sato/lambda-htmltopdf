#!/usr/bin/env bash

set -e

source ./bin/exports_from_dotenv ".env"

if [ -z "$DOCKER_REPOSITORY" ]; then
  echo "Error: DOCKER_REPOSITORY is not defined."
  exit 1
fi

if [ -z "$AWS_LAMBDA_FUNCTION" ]; then
  echo "Error: AWS_LAMBDA_FUNCTION is not defined."
  exit 1
fi

if [ -z "$DOCKER_DEFAULT_PLATFORM" ]; then
  export DOCKER_DEFAULT_PLATFORM="linux/amd64"
fi

readonly src_tag=${APP_NAME:-htmltopdf}:${DOCKER_TAG:-dev}
docker build -t ${src_tag} .
aws ecr get-login-password | docker login --username AWS --password-stdin ${DOCKER_REPOSITORY}

# @see https://docs.aws.amazon.com/ja_jp/lambda/latest/dg/nodejs-image.html
# MUST set latest tag
docker tag ${src_tag} ${DOCKER_REPOSITORY}:latest
docker push ${DOCKER_REPOSITORY}:latest

if [ "$DOCKER_DEFAULT_PLATFORM" = "linux/amd64" ]; then
  arch="x86_64"
else
  arch="arm64"
fi

# @see https://stackoverflow.com/questions/56614404/how-to-suppress-aws-lambda-cli-output
output=$(aws lambda update-function-code --function-name ${AWS_LAMBDA_FUNCTION} --image-uri ${DOCKER_REPOSITORY}:latest --architectures ${arch}  --no-cli-pager 2>&1)
if [ $? -ne 0 ]; then
  echo "Error: $output"
fi

echo "Waiting for ${AWS_LAMBDA_FUNCTION} to be deployed..."
aws lambda wait function-updated-v2 --function-name ${AWS_LAMBDA_FUNCTION}
echo "Deployed ${AWS_LAMBDA_FUNCTION} successfully"
